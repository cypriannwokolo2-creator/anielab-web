# Copy to .env.local and fill in the values.
# Supabase anon key: Dashboard → Settings → API keys → anon public
# Pinata gateway: your dedicated gateway subdomain, e.g. green-resonance.mypinata.cloud

NEXT_PUBLIC_SUPABASE_URL=https://fazxuwimazzcrpeskjvr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# WalletConnect Cloud projectId (Reown) — enables the WalletConnect modal in
# "Connect any wallet". Grab one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_USDC_SAC_TESTNET=

NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

NEXT_PUBLIC_PINATA_GATEWAY=
