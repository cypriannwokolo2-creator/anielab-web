# Copy to .env.local and fill in the values.
# Supabase anon key: Dashboard → Settings → API keys → anon public
# MinIO public media origin: set after the MinIO bucket + Caddy route exist.

NEXT_PUBLIC_SUPABASE_URL=https://fazxuwimazzcrpeskjvr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# WalletConnect Cloud projectId (Reown) — enables the WalletConnect modal in
# "Connect any wallet". Grab one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_USDC_SAC_TESTNET=
# Fallback XLM→USDC rate used by the fund dialog when the testnet DEX orderbook
# has no USDC/XLM liquidity (live orderbook rate is tried first).
NEXT_PUBLIC_XLM_USDC_RATE=0.12

NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Public media origin (MinIO behind Caddy), e.g. https://minio.anielab.app
NEXT_PUBLIC_MEDIA_BASE_URL=
